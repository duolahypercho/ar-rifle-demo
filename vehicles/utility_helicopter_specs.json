{
  "asset": "utility_helicopter",
  "description": "Unbranded civilian utility helicopter concept for an open-world game: exterior, first-person cockpit, finished cabin, animated rotors and doors. Asset package only; flight physics, rotor-speed control and entry/exit logic are separate integration work.",
  "units": "metres (1 Blender unit = 1 m)",
  "axes": {
    "blender": {
      "forward": "+Y",
      "up": "+Z",
      "right": "+X",
      "left": "-X (the seated pilot's left)"
    },
    "gltf": {
      "forward": "-Z",
      "up": "+Y",
      "right": "+X",
      "conversion": "standard Blender Z-up to glTF Y-up export: (x, y, z) -> (x, z, -y)"
    },
    "helicopter_root": "ground level, directly below the main rotor mast",
    "helper_convention": "Every helper empty has local +Y = forward (facing / view / beam direction) and local +Z = up in Blender. The exporter converts node axes with the positions, so in the GLB the same helper has local -Z = forward and local +Y = up, which is the glTF camera and KHR_lights_punctual convention: a camera or spot light parented to camera_cockpit or landing_light_point with an identity transform points the right way."
  },
  "dimensions_m": {
    "targets": {
      "fuselage_length_excluding_main_rotor": 10.5,
